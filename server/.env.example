# Copy to server/.env for local development. Never commit the real .env file.
NODE_ENV=development
PORT=4000

# MongoDB Atlas (production) or a local MongoDB (development)
MONGODB_URI=mongodb://127.0.0.1:27017/courselens

# Long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
FILE_URL_SECRET=change-me-three

# The React app's public URL (used in email links and CORS)
CLIENT_URL=http://localhost:5173
# Extra allowed origins, comma separated (optional)
CORS_ORIGINS=http://localhost:5173

# Session lengths
ACCESS_TOKEN_TTL=15m
SESSION_IDLE_TTL=2h
REMEMBER_ME_TTL=30d

# Optional services. Without them, files are stored in server/uploads and emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=CourseLens <no-reply@yourdomain.com>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=courselens/dev
